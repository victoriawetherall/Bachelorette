NEXT_PUBLIC_INSFORGE_BASE_URL=https://your-app.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key_here
# Shared, hidden Insforge account the app signs in as (in the browser) purely to
# get past Insforge's storage-write permission check for photo uploads. Guests
# never see this account or a login screen — it's an implementation detail, not
# a real user account. See CLAUDE.md / project notes for why this exists.
NEXT_PUBLIC_UPLOAD_ACCOUNT_EMAIL=your_shared_upload_account_email
NEXT_PUBLIC_UPLOAD_ACCOUNT_PASSWORD=your_shared_upload_account_password
