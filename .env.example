NEXT_PUBLIC_INSFORGE_BASE_URL=https://your-app.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key_here
# Shared InsForge account used only by the server for photo uploads.
# Guests never receive these credentials or need an upload-account login.
UPLOAD_ACCOUNT_EMAIL=your_shared_upload_account_email
UPLOAD_ACCOUNT_PASSWORD=your_shared_upload_account_password
ADMIN_PASSWORD=your_existing_app_organiser_password
NEXT_PUBLIC_BANK_NAME=account_holder_name
NEXT_PUBLIC_BANK_BSB=bank_bsb
NEXT_PUBLIC_BANK_ACCOUNT=bank_account_number

# Trivia connects directly to the same InsForge PostgreSQL database on the server.
# Use the existing project's SSL connection string; never prefix this with NEXT_PUBLIC_.
TRIVIA_DATABASE_URL=
# A private password for trivia hosting; the original organiser login is separate.
TRIVIA_HOST_PASSWORD=
